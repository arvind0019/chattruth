# ========================================================
# ChatTruth - Environment Configuration Reference
# Copy to server/.env or root .env for local development
# ========================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Database (MongoDB Atlas or local MongoDB)
# For local dev without Mongo running, ChatTruth has a built-in safe in-memory fallback store
MONGODB_URI=mongodb://localhost:27017/chattruth

# Authentication & Sessions
# Generate with: openssl rand -base64 32
SESSION_SECRET=super_secret_session_key_chattruth_change_in_production_min_32_chars
JWT_SECRET=super_secret_jwt_key_chattruth_change_in_production_min_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Google Gemini AI Integration
# Server-side only; never expose to frontend
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Email Service (Resend)
# If left blank, mock email logger will be used in development
RESEND_API_KEY=
EMAIL_FROM=ChatTruth <support@chattruth.app>

# Payment Providers
# Active provider: 'razorpay' or 'stripe'
PAYMENT_PROVIDER=razorpay
# Product pricing in smallest currency unit (e.g., 499 INR = 49900 paise or 9.99 USD = 999 cents)
REPORT_PRICE_INR=49900
REPORT_PRICE_USD=999

# Razorpay (India & International)
# In development, leave blank to enable the safe mock checkout sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Alternative)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Background Job Queue (Optional - Redis / BullMQ)
# If empty, built-in asynchronous in-memory job engine will run
REDIS_URL=

# Private File Storage (AWS S3 / Cloudflare R2 / MinIO)
# If empty, secure local disk temporary storage with automatic post-analysis wipe is used
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_ACCESS_KEY=
PRIVATE_STORAGE_SECRET_KEY=

# Error Monitoring (Optional)
SENTRY_DSN=

# Admin Initial Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@chattruth.app
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword123!
